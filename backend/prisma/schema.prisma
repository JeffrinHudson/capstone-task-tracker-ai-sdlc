generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id        String     @id @default(cuid())
  title     String
  status    TaskStatus @default(TODO)

  /// Date-only ISO format: "YYYY-MM-DD"
  dueDate   String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([dueDate])
}
